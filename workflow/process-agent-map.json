  "orchestration_rules": {
    "execution_order": ["lead_agent", "required_technical_agents", "assurance_agents", "advisory_agents", "decision_meeting", "human_signoff", "baseline_promotion"],
    "parallelism": "같은 phase 안에서 선행조건이 충족된 독립 미션은 병렬 실행한다.",
    "parallel_tracks": [
      {"track_id":"TRK-SITE-BUSINESS","phases":["P02","P03"],"start_condition":"G0 pass or approved conditional with ProjectIntent and jurisdiction","shared_inputs":["ProjectIntent","Jurisdiction"],"conflict_rule":"공통 입력 변경 시 두 트랙 모두 REVIEW_REQUIRED"},
      {"track_id":"TRK-HYDROGEN-GRID","phases":["P04","P05"],"start_condition":"G1 pass or approved conditional with site candidate and demand basis","shared_inputs":["site_candidate","power_target","dispatch_case"],"conflict_rule":"용량·운전모드 변경 시 양 트랙 재실행"},
      {"track_id":"TRK-PERMIT-FEED-PREP","phases":["P06","P07"],"start_condition":"G2 technical basis available; no unresolved safety blocker","shared_inputs":["design_basis","permit_matrix","risk_register"],"conflict_rule":"허가조건·설계기준 변경 시 P06/P07 재기준선"}
    ],
    "rebaseline_policy": {
      "trigger_events":["new_law_or_permit_condition","site_or_coordinate_change","hydrogen_supply_change","grid_condition_change","design_change","incident","contract_change"],
      "sequence":["create_change_request","impact_analysis","mark_dependent_missions_review_required","invalidate_or_supersede_outputs","rerun_affected_missions","human_approve_new_baseline","reopen_affected_gate"],
      "no_silent_progression": true
    },
    "international_overlay_policy": {
      "activation_rule":"host_country != Korea OR cross_border_contract == true OR international_financing == true OR foreign_epc_or_vendor == true",
      "required_gate_checks":{"G2":["standards_applicability_matrix","certification_and_conformity_plan","international_grid_or_supply_chain_check"],"G3":["local_permit_and_language_matrix","E&S_or_lender_requirements"],"G4":["contract_law_and_FIDIC_review","lender_technical_advisor_review","trade_tax_customs_and_multilingual_consistency"]},
      "source":"agents/international-overlay.json"
    },
    "calculation_kernel_policy": {
      "status":"controlled_overlay",
      "kernel_ref":"knowledge/calculation-kernel.json",
      "kernel_spec":"docs/02-engineering/h2-calc-kernel.md",
      "jira_epic":"SCRUM-29",
      "protection_issue":"SCRUM-39",
      "protected_program":"SCRUM-18",
      "required_for_missions":["M-013","M-014","M-018","M-019","M-031","M-034","M-035","M-036","M-042","M-043","M-044","M-047","M-048","M-061","M-062","M-063","M-064","M-065","M-071","M-072","M-073","M-074","M-075","M-076","M-089","M-090","M-091","M-092","M-095","M-096","M-097","M-098"],
      "invariants":["LLM does not invent numeric outputs","dimension mismatch blocks","T5 input cannot yield higher reliability","calculation is not safety or permit approval","all runs are append-only"],
      "promotion_rule":"A kernel result becomes Gate Evidence only after input snapshot, calculator version, evidence IDs, unit checks and required human review are recorded."
    },
    "meeting_required_when": ["risk_class_C_or_D", "cross_domain_conflict", "gate_review", "change_class_C3_or_higher", "missing_or_conflicting_evidence"],
    "default_blockers": ["필수 입력 누락", "근거 없는 확정값", "미해결 기술 이견", "필수 인간 검토 미완료", "법정 책임자 미지정"],
    "no_silent_progression": true
  },
