  "title": "Forge H2 International Project Agent Overlay",
  "project_id": "FHZ-ENTERPRISE-001",
  "version": "1.0.0",
  "activation_rule": "host_country != Korea OR cross_border_contract == true OR international_financing == true OR foreign_epc_or_vendor == true",
  "principle": "국내 기본 조직을 유지하고, 국가·금융·계약·표준·현지 책임 차이를 국제 오버레이로 추가한다.",
  "standards_hierarchy": ["host_country_law_and_permits", "financing_and_contract_obligations", "adopted_international_standards", "owner_and_company_standards"],
  "international_agents": [
    {"agent_id":"AG-INT-001","name":"International Program Director Agent","purpose":"국가·조직·계약·금융·일정의 국제 통합","professional_profile":"국제 EPC/인프라 프로그램 디렉터","approval_scope":["international_baseline_recommendation","escalation"],"must_consult":["AG-INT-002","AG-INT-003","AG-INT-005","AG-INT-009"]},
    {"agent_id":"AG-INT-002","name":"Owner's Engineer·Technical Authority Agent","purpose":"발주자 측 설계·성능·인터페이스 독립 기술권한","professional_profile":"다국가 발전·플랜트 Owner's Engineer 또는 수석기술자","approval_scope":["owner_technical_recommendation"],"must_consult":["AG-ENG-001","AG-INT-004","AG-INT-005","AG-INT-015"]},
    {"agent_id":"AG-INT-003","name":"Lender's Technical Advisor·Independent Engineer Agent","purpose":"대주단 기술실사·금융종결·건설진도·성능검증","professional_profile":"대주단 지정 독립기술자 또는 프로젝트 파이낸스 기술자문사","approval_scope":["lender_technical_opinion"],"must_consult":["AG-FIN-001","AG-INT-007","AG-INT-015","AG-INT-016"]},
