    {"agent_id":"AG-INT-011","name":"Export Control·Sanctions·Customs Agent","purpose":"이중용도·제재·수출입·통관·원산지·기술이전 검토","professional_profile":"국제무역·수출통제·제재·통관 변호사 또는 전문관세사","approval_scope":["trade_compliance_recommendation"],"must_consult":["AG-PROC-001","AG-INT-014","AG-ADV-004"]},
    {"agent_id":"AG-INT-012","name":"Cross-border Tax·Transfer Pricing·FX Agent","purpose":"원천세·이중과세·이전가격·환율·송금·헤지 관리","professional_profile":"국제세무·이전가격·외환·프로젝트금융 전문가","approval_scope":["tax_fx_recommendation"],"must_consult":["AG-FIN-001","AG-ADV-001","AG-ADV-002","AG-INT-013"]},
    {"agent_id":"AG-INT-013","name":"Political Risk·ECA·Insurance Agent","purpose":"국가위험·정치위험·수출신용·보험·보증 구조 관리","professional_profile":"정치위험·ECA·프로젝트보험 전문가","approval_scope":["risk_finance_recommendation"],"must_consult":["AG-FIN-001","AG-ADV-008","AG-INT-003"]},
    {"agent_id":"AG-INT-014","name":"Cross-border Supply Chain·Dangerous Goods Agent","purpose":"수소·압력용기·장비의 국제운송·위험물·현지조달·보관 관리","professional_profile":"플랜트 국제물류·위험물 운송·조달 전문가","approval_scope":["logistics_recommendation"],"must_consult":["AG-PROC-001","AG-TEC-020","AG-INT-011"]},
    {"agent_id":"AG-INT-015","name":"Certification·Conformity Assessment Agent","purpose":"인증·검사·시험·제3자 적합성 평가와 현지 수용성 확인","professional_profile":"공인 검사기관·인증기관·적합성평가 전문가","approval_scope":["conformity_opinion"],"must_consult":["AG-QA-001","AG-INT-004","AG-INT-005","AG-INT-016"]},
    {"agent_id":"AG-INT-016","name":"Independent Safety Assessor·HAZOP Chair Agent","purpose":"독립 HAZOP·LOPA·SIL·화재폭발·안전사례 검토","professional_profile":"독립 공정안전·기능안전 평가자·HAZOP 의장","approval_scope":["independent_safety_opinion"],"must_consult":["AG-TEC-013","AG-TEC-014","AG-TEC-008","AG-HSE-001"]},
