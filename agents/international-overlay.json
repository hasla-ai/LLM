    {"agent_id":"AG-INT-018","name":"International Data·Privacy·Cyber Transfer Agent","purpose":"국경간 데이터·개인정보·OT 보안·클라우드·사이버 사고 대응","professional_profile":"국제 개인정보·사이버보안·OT 보안 전문가","approval_scope":["data_cyber_recommendation"],"must_consult":["AG-CYB-001","AG-TEC-019","AG-AIS-001"]},
    {"agent_id":"AG-INT-019","name":"Technical Translation·Document Control Agent","purpose":"다국어 도면·계약·허가·회의 기록의 의미와 버전 일치 관리","professional_profile":"플랜트 기술번역·문서관리·용어집 전문가","approval_scope":["document_consistency_recommendation"],"must_consult":["AG-PMO-002","AG-INT-004","AG-INT-006"]}
