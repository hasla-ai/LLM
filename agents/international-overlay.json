    {"agent_id":"AG-INT-007","name":"ESG·E&S Performance Standards Agent","purpose":"IFC Performance Standards·Equator Principles·ESMS·행동계획 관리","professional_profile":"국제금융 E&S 자문사·환경사회영향평가 전문가","approval_scope":["esg_action_plan_recommendation"],"must_consult":["AG-TEC-017","AG-ADV-007","AG-INT-008","AG-INT-003"]},
