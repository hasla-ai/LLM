{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-h2.local/schema/calculation-kernel.schema.json",
  "title": "Forge H2 Calculation Kernel",
  "type": "object",
  "additionalProperties": false,
  "required": ["kernel_id", "project_id", "version", "status", "jira_epic", "protection_issue", "preserves", "source_libraries", "execution_policy", "quantity_contract", "mission_run_contract", "required_output_fields", "non_decisions", "mission_bindings", "change_policy", "extensions"],
  "properties": {
    "$schema": {"type":"string"},
    "kernel_id": {"type":"string","pattern":"^FHZ-[A-Z0-9-]+$"},
    "project_id": {"type":"string"},
    "version": {"type":"string"},
    "status": {"type":"string","enum":["planned","controlled_overlay","active","retired"]},
    "jira_epic": {"type":"string","pattern":"^SCRUM-[0-9]+$"},
    "protection_issue": {"type":"string","pattern":"^SCRUM-[0-9]+$"},
    "preserves": {"type":"array","minItems":1,"items":{"type":"string"}},
    "source_libraries": {"type":"array","minItems":1,"items":{"type":"string"}},
    "execution_policy": {"type":"object","additionalProperties":false,"required":["executor","allowed_language","allow_dynamic_code","requires_unit_check","requires_input_snapshot","requires_calculator_version"],"properties":{"executor":{"type":"string","const":"deterministic"},"allowed_language":{"type":"string"},"allow_dynamic_code":{"type":"boolean","const":false},"requires_unit_check":{"type":"boolean","const":true},"requires_input_snapshot":{"type":"boolean","const":true},"requires_calculator_version":{"type":"boolean","const":true}}},
    "quantity_contract": {"type":"string"},
    "mission_run_contract": {"type":"string"},
    "required_output_fields": {"type":"array","minItems":1,"items":{"type":"string"}},
    "non_decisions": {"type":"array","minItems":1,"items":{"type":"string"}},
    "mission_bindings": {"type":"object","additionalProperties":{"type":"array","items":{"type":"string","pattern":"^M-[0-9]{3}$"}}},
    "change_policy": {"type":"object","additionalProperties":false,"required":["change_request_required","regression_required","human_review_required","reopen_affected_gate","append_only_runs"],"properties":{"change_request_required":{"type":"boolean","const":true},"regression_required":{"type":"boolean","const":true},"human_review_required":{"type":"boolean","const":true},"reopen_affected_gate":{"type":"boolean","const":true},"append_only_runs":{"type":"boolean","const":true}}},
    "extensions": {"type":"object","additionalProperties":true}
  }
}
