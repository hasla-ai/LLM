{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-h2.local/schema/mission-definition.schema.json",
  "title": "Forge H2 Mission Definition",
  "description": "A function-like, versioned contract that tells an Agent what one mission must accept and return.",
  "type": "object",
  "additionalProperties": false,
  "required": ["mission_id", "schema_version", "code", "name", "purpose", "phase", "owner_role", "risk_class", "gate", "dependencies", "input_contract", "output_contract", "completion_criteria", "block_conditions", "review_policy", "extensions"],
  "properties": {
    "mission_id": {"$ref": "common.schema.json#/$defs/id", "pattern": "^M-[0-9]{3}$", "examples": ["M-001"]},
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,80}$", "description": "Stable function-like name used by the orchestrator.", "examples": ["capture_intent", "run_hazid"]},
    "name": {"type": "string", "minLength": 1, "description": "Human-readable mission name."},
    "purpose": {"type": "string", "minLength": 1, "description": "One sentence: why this mission exists."},
    "phase": {"type": "string", "enum": ["intake", "business", "site", "hydrogen", "power_grid", "concept_design", "safety_permit", "feed_epc", "construction", "operations"]},
    "owner_role": {"$ref": "common.schema.json#/$defs/role"},
    "risk_class": {"$ref": "common.schema.json#/$defs/risk_class"},
    "gate": {"type": "string", "pattern": "^G[0-7]$", "description": "Gate at which this mission contributes evidence."},
    "dependencies": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/id"}, "description": "Mission IDs that must pass or be conditionally approved first."},
    "parallel_group": {"type": ["string", "null"], "description": "Missions in the same group may run in parallel when dependencies pass."},
    "input_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref", "required_fields", "optional_fields", "accepts_unknowns"],
      "properties": {
        "schema_ref": {"type": "string", "description": "Relative path or registered schema ID."},
        "required_fields": {"type": "array", "items": {"type": "string"}},
        "optional_fields": {"type": "array", "items": {"type": "string"}},
        "accepts_unknowns": {"type": "boolean", "description": "If false, null or missing required values cause BLOCKED."},
        "units_required": {"type": "array", "items": {"type": "string"}},
        "evidence_required": {"type": "boolean", "default": true}
      }
    },
    "output_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref", "required_fields", "quality_checks"],
      "properties": {
        "schema_ref": {"type": "string"},
        "required_fields": {"type": "array", "items": {"type": "string"}},
        "quality_checks": {"type": "array", "items": {"type": "string"}},
        "next_mission_fields": {"type": "array", "items": {"type": "string"}}
      }
    },
    "completion_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}, "description": "Observable conditions for PASS."},
    "block_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}, "description": "Conditions that force BLOCKED instead of guessing."},
    "review_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "review_role", "approval_required_for_baseline"],
      "properties": {
        "required": {"type": "boolean"},
        "review_role": {"$ref": "common.schema.json#/$defs/role"},
        "approval_required_for_baseline": {"type": "boolean"},
        "minimum_reviewers": {"type": "integer", "minimum": 0, "default": 1}
      }
    },
    "executor": {"type": "string", "enum": ["deterministic", "llm", "human", "hybrid"], "description": "Preferred executor. High-risk missions should be hybrid or human."},
    "implementation_ref": {"type": ["string", "null"], "description": "Code or service reference owned by another Agent/team."},
    "extensions": {"type": "object", "additionalProperties": true}
  }
}
