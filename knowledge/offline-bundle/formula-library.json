    {"formula_id": "FML-FLUID-002", "domain": "fluid", "name": "베르누이 방정식 압력 계산", "equation_latex": "P_2=P_1+\\frac{1}{2}\\rho(v_1^2-v_2^2)+\\rho g(z_1-z_2)", "equation_ascii": "P2 = P1 + 0.5*rho*(v1**2-v2**2) + rho*g*(z1-z2)", "solved_for": "P2", "python": {"call_signature": "bernoulli_pressure_2(P1, rho, v1, v2, g, z1, z2)", "expression": "P1 + 0.5 * rho * (v1**2 - v2**2) + rho * g * (z1 - z2)"}, "sympy": "Eq(P2,P1+rho*(v1**2-v2**2)/2+rho*g*(z1-z2))", "variables": [{"symbol": "P1", "meaning": "지점 1 압력", "unit": "Pa"}, {"symbol": "rho", "meaning": "밀도", "unit": "kg/m^3"}, {"symbol": "v1,v2", "meaning": "지점별 유속", "unit": "m/s"}, {"symbol": "g", "meaning": "중력가속도", "unit": "m/s^2"}, {"symbol": "z1,z2", "meaning": "고도", "unit": "m"}], "assumptions": ["정상·비점성·비압축성 유동", "펌프·손실수두 제외"], "source_knowledge_id": "KNW-FOUNDATION-FORMULA-LIBRARY", "verification_status": "unverified"},
    {"formula_id": "FML-HEAT-001", "domain": "heat", "name": "Fourier 열전도 법칙", "equation_latex": "q=-kA(dT/dx)", "equation_ascii": "q = -k * area * dT_dx", "solved_for": "q", "python": {"call_signature": "conduction_heat_rate(k, area, dT_dx)", "expression": "-k * area * dT_dx"}, "sympy": "Eq(q,-k*A*dT_dx)", "variables": [{"symbol": "k", "meaning": "열전도율", "unit": "W/(m*K)"}, {"symbol": "A", "meaning": "전열면적", "unit": "m^2"}, {"symbol": "dT_dx", "meaning": "온도구배", "unit": "K/m"}], "assumptions": ["국부 1차원 전도", "k의 공간변화 무시"], "source_knowledge_id": "KNW-FOUNDATION-FORMULA-LIBRARY", "verification_status": "unverified"},
