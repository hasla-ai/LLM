    {"formula_id": "FML-THERMO-001", "domain": "thermodynamics", "name": "이상기체 상태방정식", "equation_latex": "PV=nRT", "equation_ascii": "P = n * R * T / V", "solved_for": "P", "python": {"call_signature": "ideal_gas_pressure(n, R, T, V)", "expression": "n * R * T / V"}, "sympy": "Eq(P,n*R*T/V)", "variables": [{"symbol": "P", "meaning": "압력", "unit": "Pa"}, {"symbol": "V", "meaning": "부피", "unit": "m^3"}, {"symbol": "n", "meaning": "몰수", "unit": "mol"}, {"symbol": "R", "meaning": "기체상수", "unit": "J/(mol*K)"}, {"symbol": "T", "meaning": "절대온도", "unit": "K"}], "assumptions": ["이상기체 근사", "절대압력 사용"], "source_knowledge_id": "KNW-FOUNDATION-FORMULA-LIBRARY", "verification_status": "unverified"},
