    {"formula_id": "FML-COMB-001", "domain": "combustion", "name": "Le Chatelier 혼합가스 LFL", "equation_latex": "LFL_mix=100/(sum(C_i/LFL_i))", "equation_ascii": "LFL_mix = 100 / sum(C_i / LFL_i)", "solved_for": "LFL_mix", "python": {"call_signature": "mixture_lfl(concentrations, component_lfls)", "expression": "100.0 / sum(C_i / LFL_i for C_i, LFL_i in zip(concentrations, component_lfls))"}, "sympy": "Eq(LFL_mix,100/sum(C_i/LFL_i))", "variables": [{"symbol": "C_i", "meaning": "혼합물 중 성분 농도", "unit": "%"}, {"symbol": "LFL_i", "meaning": "성분별 폭발하한", "unit": "%"}], "assumptions": ["가연성 성분 혼합물", "농도와 LFL의 단위 일치", "실제 수소 방출·환기·점화조건 검토를 대체하지 않음"], "source_knowledge_id": "KNW-FOUNDATION-FORMULA-LIBRARY", "verification_status": "unverified"},
