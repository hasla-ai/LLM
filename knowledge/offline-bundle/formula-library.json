    {"formula_id": "FML-POWER-002", "domain": "power_system", "name": "퍼센트 임피던스 단락전류", "equation_latex": "I_s=(100/\\%Z)I_n", "equation_ascii": "I_s = (100 / percent_Z) * I_n", "solved_for": "I_s", "python": {"call_signature": "short_circuit_current(percent_Z, I_n)", "expression": "(100.0 / percent_Z) * I_n"}, "sympy": "Eq(I_s,100*I_n/percent_Z)", "variables": [{"symbol": "%Z", "meaning": "퍼센트 임피던스", "unit": "%"}, {"symbol": "I_n", "meaning": "정격전류", "unit": "A"}], "assumptions": ["percent_Z는 5와 같은 퍼센트 수치로 입력"], "source_knowledge_id": "KNW-FOUNDATION-FORMULA-LIBRARY", "verification_status": "unverified"},
