{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-h2.local/schema/offline-requirements.schema.json",
  "title": "Forge H2 Offline Requirements",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_id", "mode", "network_policy", "requirements"],
  "properties": {
    "$schema": {"type": "string", "format": "uri-reference"},
    "project_id": {"$ref": "common.schema.json#/$defs/id"},
    "mode": {"type": "string", "const": "offline"},
    "network_policy": {"type": "string", "const": "deny_all_remote_fetch"},
    "requirements": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["requirement_id", "category", "description", "required_artifacts", "status", "blocks_gates", "owner"], "properties": {"requirement_id": {"type": "string", "pattern": "^OFF-"}, "category": {"type": "string"}, "description": {"type": "string"}, "required_artifacts": {"type": "array", "items": {"type": "string"}}, "status": {"type": "string", "enum": ["available_local", "partial", "partial_metadata_only", "missing"]}, "blocks_gates": {"type": "array", "items": {"type": "string", "pattern": "^G[0-7]$"}}, "owner": {"type": "string"}}}}
  }
}
