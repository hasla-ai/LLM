{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-h2.local/schema/decision.schema.json",
  "title": "Forge H2 Decision Record",
  "description": "An auditable decision record linking evidence, Agent positions, human approvers and conditions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision_id", "project_id", "schema_version", "decision_type", "subject", "status", "options", "recommendation", "decision_owner_role", "approvers", "evidence_ids", "invocation_ids", "conditions", "human_signoff", "created_at", "decided_at", "extensions"],
  "properties": {
    "decision_id": {"$ref": "common.schema.json#/$defs/id", "pattern": "^DEC-[A-Za-z0-9._-]+$"},
    "project_id": {"$ref": "common.schema.json#/$defs/id"},
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "decision_type": {"type": "string", "enum": ["gate", "technical", "safety", "permit", "commercial", "finance", "change", "operations", "ai_release"]},
    "subject": {"type": "string", "minLength": 1},
    "status": {"$ref": "common.schema.json#/$defs/decision_status"},
    "options": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "recommendation": {"type": "string", "minLength": 1},
    "decision_owner_role": {"$ref": "common.schema.json#/$defs/role"},
    "approvers": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/person_or_role"}},
    "evidence_ids": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/id"}},
    "invocation_ids": {"type": "array", "items": {"type": "string", "pattern": "^CALL-[A-Za-z0-9._-]+$"}},
    "conditions": {"type": "array", "items": {"type": "string"}},
    "human_signoff": {"type": "boolean", "const": true},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "decided_at": {"anyOf": [{"$ref": "common.schema.json#/$defs/timestamp"}, {"type": "null"}]},
    "supersedes_decision_id": {"type": ["string", "null"], "pattern": "^DEC-[A-Za-z0-9._-]+$"},
    "extensions": {"type": "object", "additionalProperties": true}
  }
}
